# Microsoft's voice files: never in this repository. Sam, Mike and Mary are
# Microsoft's, and the program reads them from where they are installed or
# from a `voices` folder beside it -- which is kept out of here with them.
voices/
*.spd
*.sdf
*.lxa
*.LXA

# What this program makes: rendered audio, and songs saved in the checkout
out/
*.wav
*.aiff
*.wst
*.vws

# What the build makes
build/
dist/
lib/
*.egg-info/

# Built, not written
*.pyd
*.so
*.dylib
__pycache__/
*.py[cod]

# Environments and editors
.venv/
venv/
env/
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
